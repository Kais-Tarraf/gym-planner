{
	"compilerOptions": {
		"target": "ES2022",
		"module": "preserve",
		"lib": ["ES2022"],
		"moduleResolution": "bundler",
		"rootDir": "./",
		"outDir": "./dist",
		"strict": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"types": [
   "node"
  ]
	},
	"include": ["./**/*"],
	"exclude": ["node_modules", "dist"]
}
